{
  // Schema for editor validation. Update only when intentionally adopting a new schema.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate config for NWarila/terraform-runner-template — the canonical
  // baseline for every Terraform-runner consumer in the portfolio. This
  // file is the single source of truth for Renovate behavior across every
  // Terraform repo under nwarila-platform; consumers extend it via
  // `extends: ["github>NWarila/terraform-runner-template"]` (see org
  // ADR-0004 in nwarila-platform/.github for the per-template-baseline
  // model).
  //
  // Rules in this file:
  //   - Pin third-party GitHub Actions to commit SHAs (matches the OPA
  //     golden_terraform package's enforcement and org ADR-0004's
  //     SHA-pin retention check).
  //   - Pin Terraform and provider versions exactly (template-tier
  //     ADR-template/0001 in this repo at
  //     docs/decision-records/0001-pin-terraform-and-provider-versions-exactly.md).
  //   - Track explicit `# renovate:` annotations in workflow comments
  //     for tool versions (Terraform CLI, TFLint, terraform-docs, OPA,
  //     zizmor).

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "schedule:weekly"
  ],

  "labels": ["dependencies"],
  "prConcurrentLimit": 5,

  "enabledManagers": [
    "github-actions",
    "terraform",
    "pip_requirements",
    "custom.regex"
  ],

  "customManagers": [
    {
      // Match `# renovate: datasource=...` annotations followed by a
      // value: "..." or value: '...' assignment. Catches Terraform/TFLint/
      // terraform-docs/OPA/zizmor versions in workflow inputs and shell
      // scripts.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^tools/.*\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+\\w+(?:_VERSION)?:\\s*\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+\\w+_VERSION=\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+pip install --no-cache-dir (?<depName2>[a-zA-Z0-9-._]+)==(?<currentValue>[^\\s]+)"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["terraform"],
      "rangeStrategy": "pin",
      "semanticCommitType": "deps",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": ["hashicorp/terraform"],
      "groupName": "Terraform CLI",
      "semanticCommitType": "deps",
      "semanticCommitScope": "deps"
    },
    {
      // Bumps to NWarila/terraform-runner-template itself (when consumers
      // pin against this template's SHA in their drift-gate.yaml or
      // workflow `uses:` references) are grouped and never automerged —
      // the maintainer reviews them.
      "matchDepNames": ["NWarila/terraform-runner-template"],
      "groupName": "terraform-runner-template",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    }
  ]
}
