# ----- [ Runner data: public + private + fixtures ] -----------------------------------------------
# Per the runner contract, data-only deployers carry repos/public/
# (synced into source) and repos/private/ (typically fetched from S3
# at deploy time). tests/fixtures/ holds the public-safe fallback
# the runner's pr-validation overlays in CI when AWS isn't
# available for the S3 fetch.
!/repos/
!/repos/public/
!/repos/public/.gitkeep
!/repos/public/sample-environments.tfvars
!/repos/private/
!/repos/private/.gitkeep
!/tests/
!/tests/fixtures/
!/tests/fixtures/.gitkeep
!/tests/fixtures/repos/
!/tests/fixtures/repos/public/
!/tests/fixtures/repos/public/.gitkeep
!/tests/fixtures/repos/private/
!/tests/fixtures/repos/private/.gitkeep
!/tests/fixtures/repos/private/sample-private-environments.tfvars

# ----- [ Integration fixtures ] -------------------------------------------------------------------
!/fixtures/
!/fixtures/integration/
!/fixtures/integration/basic/
!/fixtures/integration/basic/versions.tf
!/fixtures/integration/basic/variables.tf
!/fixtures/integration/basic/main.tf
!/fixtures/integration/basic/tests/
!/fixtures/integration/basic/tests/runner_consumes_framework.tftest.hcl
